{
  "name": "martajs",
  "version": "0.1.0",
  "description": "TypeScript client for MARTA bus GTFS Realtime feeds and train arrivals.",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "./dist/app.js",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "gtfs-realtime-bindings": "^2.2.0",
    "protobufjs": "^8.8.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheflow/marta-js.git"
  },
  "bugs": {
    "url": "https://github.com/cacheflow/marta-js/issues"
  },
  "homepage": "https://github.com/cacheflow/marta-js#readme",
  "publishConfig": {
    "access": "public"
  }
}
